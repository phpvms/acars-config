{
  "meta": { "id": "xplane_default", "name": "xplane default", "sim": "xplane", "priority": 1, "author": "acars", "version": 1 },
  "match": [[]],
  "features": {
    "BeaconLights": [
      { "if": { "all": [{ "kind": "dataref", "address": "sim/cockpit2/switches/beacon_on", "valueType": "int", "operator": "equal", "value": 1 }] }, "action": { "value": true } },
      { "action": { "value": false } }
    ],
    "LandingLights": [
      { "if": { "all": [{ "kind": "dataref", "address": "sim/cockpit2/switches/landing_lights_on", "valueType": "int", "operator": "equal", "value": 1 }] }, "action": { "value": true } },
      { "action": { "value": false } }
    ],
    "NavigationLights": [
      { "if": { "all": [{ "kind": "dataref", "address": "sim/cockpit2/switches/navigation_lights_on", "valueType": "int", "operator": "equal", "value": 1 }] }, "action": { "value": true } },
      { "action": { "value": false } }
    ],
    "StrobeLights": [
      { "if": { "all": [{ "kind": "dataref", "address": "sim/cockpit2/switches/strobe_lights_on", "valueType": "int", "operator": "equal", "value": 1 }] }, "action": { "value": true } },
      { "action": { "value": false } }
    ],
    "TaxiLights": [
      { "if": { "all": [{ "kind": "dataref", "address": "sim/cockpit2/switches/taxi_light_on", "valueType": "int", "operator": "equal", "value": 1 }] }, "action": { "value": true } },
      { "action": { "value": false } }
    ],
    "Spoilers": [
      { "if": { "all": [{ "kind": "dataref", "address": "sim/cockpit2/controls/speedbrake_ratio", "valueType": "number", "operator": "lessThan", "value": 0 }] }, "action": { "value": 0 } },
      { "action": { "value": { "fromFact": { "kind": "dataref", "address": "sim/cockpit2/controls/speedbrake_ratio", "valueType": "number" }, "clamp": [0, 1] } } }
    ],
    "SpoilersArmed": [
      { "if": { "all": [{ "kind": "dataref", "address": "sim/cockpit2/controls/speedbrake_ratio", "valueType": "number", "operator": "lessThan", "value": 0 }] }, "action": { "value": true } },
      { "action": { "value": false } }
    ],
    "ThrustReversers": [
      { "action": { "value": { "fromFact": { "kind": "dataref", "address": "sim/flightmodel2/engines/thrust_reverser_deploy_ratio", "valueType": "numberArray" } } } }
    ]
  }
}
