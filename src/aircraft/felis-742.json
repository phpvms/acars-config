    "name": "Felis 742",
    "sim": "xplane",
    "priority": 2,
    "author": "acars"
  },
  "match": [
    [
      { "scope": "title", "op": "contains", "keyword": "boeing" },
      { "scope": "title", "op": "contains", "keyword": "747-200" }
    ]
  ],
  "disabled": {
    "BeaconLights": true,
    "NavigationLights": true,
    "StrobeLights": true
  },
  "mappings": {
