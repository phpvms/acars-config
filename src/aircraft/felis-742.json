    "TaxiLights": [
      {
        "if": {
          "all": [
            { "kind": "dataref", "address": "B742/ext_light/runway_turnoff_L_sw", "valueType": "int", "operator": "equal", "value": 1 },
            { "kind": "dataref", "address": "B742/ext_light/runway_turnoff_R_sw", "valueType": "int", "operator": "equal", "value": 1 }
          ]
        },
        "action": { "value": true }
      },
      { "action": { "value": false } }
