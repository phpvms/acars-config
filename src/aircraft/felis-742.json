    "WingLights": [
      {
        "if": { "all": [{ "kind": "dataref", "address": "B742/ext_light/wing_sw", "valueType": "int", "operator": "equal", "value": 1 }] },
        "action": { "value": true }
      },
      { "action": { "value": false } }
