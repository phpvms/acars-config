            { "kind": "dataref", "address": "B742/ext_light/landing_inbd_R_sw", "valueType": "int", "operator": "equal", "value": 1 },
            { "kind": "dataref", "address": "B742/ext_light/landing_outbd_L_sw", "valueType": "int", "operator": "equal", "value": 1 },
            { "kind": "dataref", "address": "B742/ext_light/landing_outbd_R_sw", "valueType": "int", "operator": "equal", "value": 1 }
          ]
        },
        "action": { "value": true }
      },
      { "action": { "value": false } }
    ],
    "LogoLights": [
      {
        "if": { "all": [{ "kind": "dataref", "address": "B742/ext_light/logo_sw", "valueType": "int", "operator": "equal", "value": 1 }] },
        "action": { "value": true }
      },
      { "action": { "value": false } }
