{
  "meta": {
    "id": "rotate_md80",
    "name": "Rotate MD-80",
    "sim": "xplane",
    "priority": 2,
    "author": "acars"
  },
  "match": [
    [
      { "scope": "title", "op": "contains", "keyword": "rotate" },
      { "scope": "title", "op": "contains", "keyword": "md-80" }
    ]
  ],
  "features": {
    "BeaconLights": [
      {
        "if": { "all": [{ "kind": "dataref", "address": "Rotate/md80/lights/anticollision_light_switch", "valueType": "int", "operator": "equal", "value": 1 }] },
        "action": { "value": true }
      },
      { "action": { "value": false } }
    ],
    "LandingLights": [
      {
        "if": {
          "all": [
            { "kind": "dataref", "address": "Rotate/md80/lights/wing_ldg_light_switch_r", "valueType": "int", "operator": "equal", "value": 2 },
            { "kind": "dataref", "address": "Rotate/md80/lights/wing_ldg_light_switch_l", "valueType": "int", "operator": "equal", "value": 2 }
          ]
        },
        "action": { "value": true }
      },
      { "action": { "value": false } }
    ],
    "LogoLights": [
      {
        "if": { "all": [{ "kind": "dataref", "address": "Rotate/md80/lights/logo_light_switch", "valueType": "int", "operator": "equal", "value": 1 }] },
        "action": { "value": true }
      },
      { "action": { "value": false } }
    ],
    "NavigationLights": [
      {
        "if": {
          "any": [
            { "kind": "dataref", "address": "Rotate/md80/lights/pos_strobe_light_switch", "valueType": "int", "operator": "equal", "value": 1 },
            { "kind": "dataref", "address": "Rotate/md80/lights/pos_strobe_light_switch", "valueType": "int", "operator": "equal", "value": 2 }
          ]
        },
        "action": { "value": true }
      },
      { "action": { "value": false } }
    ],
    "StrobeLights": [
      {
        "if": { "all": [{ "kind": "dataref", "address": "Rotate/md80/lights/pos_strobe_light_switch", "valueType": "int", "operator": "equal", "value": 2 }] },
        "action": { "value": true }
      },
      { "action": { "value": false } }
    ],
    "TaxiLights": [
      {
        "if": {
          "any": [
            { "kind": "dataref", "address": "Rotate/md80/lights/nose_light_switch", "valueType": "int", "operator": "equal", "value": 1 },
            { "kind": "dataref", "address": "Rotate/md80/lights/nose_light_switch", "valueType": "int", "operator": "equal", "value": 2 }
          ]
        },
        "action": { "value": true }
      },
      { "action": { "value": false } }
    ],
    "WingLights": [
      {
        "if": { "all": [{ "kind": "dataref", "address": "Rotate/md80/lights/wing_light_switch", "valueType": "int", "operator": "equal", "value": 1 }] },
        "action": { "value": true }
      },
      { "action": { "value": false } }
    ]
  }
}
