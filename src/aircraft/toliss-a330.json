{
  "meta": {
    "id": "toliss_a330",
    "name": "ToLiss Airbus A330",
    "sim": "xplane",
    "priority": 2,
    "author": "B.Fatih KOZ <https://github.com/FatihKoz>"
  },
  "match": [
    [
      { "scope": "title", "op": "contains", "keyword": "a330-941" }
    ]
  ],
  "mappings": {
    "flapNames": [
      { "value": 0, "label": "UP" },
      { "value": 1, "label": "CONF 1" },
      { "value": 2, "label": "CONF 2" },
      { "value": 3, "label": "CONF 3" },
      { "value": 4, "label": "FULL" }
    ]
  },
  "features": {
    "BeaconLights": [
      {
        "if": { "all": [{ "kind": "dataref", "address": "AirbusFBW/OHPLightSwitches", "valueType": "intArray", "index": 0, "operator": "equal", "value": 1 }] },
        "action": { "value": true }
      },
      { "action": { "value": false } }
    ],
    "LandingLights": [
      {
        "if": { "all": [{ "kind": "dataref", "address": "AirbusFBW/OHPLightSwitches", "valueType": "intArray", "index": 4, "operator": "equal", "value": 1 }] },
        "action": { "value": true }
      },
      { "action": { "value": false } }
    ],
    "NavigationLights": [
      {
        "if": {
          "any": [
            { "kind": "dataref", "address": "AirbusFBW/OHPLightSwitches", "valueType": "intArray", "index": 2, "operator": "equal", "value": 1 },
            { "kind": "dataref", "address": "AirbusFBW/OHPLightSwitches", "valueType": "intArray", "index": 2, "operator": "equal", "value": 2 }
          ]
        },
        "action": { "value": true }
      },
      { "action": { "value": false } }
    ],
    "StrobeLights": [
      {
        "if": { "all": [{ "kind": "dataref", "address": "AirbusFBW/OHPLightSwitches", "valueType": "intArray", "index": 7, "operator": "equal", "value": 1 }] },
        "action": { "value": "ignore" }
      },
      {
        "if": { "all": [{ "kind": "dataref", "address": "AirbusFBW/OHPLightSwitches", "valueType": "intArray", "index": 7, "operator": "equal", "value": 2 }] },
        "action": { "value": true }
      },
      { "action": { "value": false } }
    ],
    "TaxiLights": [
      {
        "if": {
          "any": [
            { "kind": "dataref", "address": "AirbusFBW/OHPLightSwitches", "valueType": "intArray", "index": 3, "operator": "equal", "value": 1 },
            { "kind": "dataref", "address": "AirbusFBW/OHPLightSwitches", "valueType": "intArray", "index": 3, "operator": "equal", "value": 2 }
          ]
        },
        "action": { "value": true }
      },
      { "action": { "value": false } }
    ],
    "APU": [
      {
        "if": { "all": [{ "kind": "dataref", "address": "AirbusFBW/APUAvail", "valueType": "int", "operator": "equal", "value": 1 }] },
        "action": { "value": true }
      },
      { "action": { "value": false } }
    ]
  }
}
